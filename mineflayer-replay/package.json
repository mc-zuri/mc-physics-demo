{
  "name": "mineflayer-replay",
  "version": "0.1.0",
  "private": true,
  "description": "Replays sessions of the vanilla Java client through mineflayer-physics-utils and through a whole mineflayer bot, tick by tick",
  "main": "index.js",
  "scripts": {
    "import": "node tools/import.js",
    "test": "node tools/test.js",
    "lint": "standard",
    "test:engine": "mocha --reporter dot --exit test/engine.test.js",
    "test:bot": "mocha --reporter dot --exit test/bot.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@nxg-org/mineflayer-physics-util": "workspace:*",
    "java-math": "workspace:*",
    "minecraft-data": "^3.117.0",
    "minecraft-protocol": "^1.66.0",
    "mineflayer": "workspace:*",
    "prismarine-block": "^1.23.0",
    "prismarine-chunk": "^1.40.0",
    "prismarine-registry": "^1.12.0",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "mocha": "^11.1.0",
    "standard": "^17.1.2"
  }
}
